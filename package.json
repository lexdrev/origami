{
  "name": "origami",
  "version": "0.1.0",
  "description": "Power, fans, display, light and gamepad settings for the ROG Xbox Ally X",
  "license": "GPL-3.0-or-later",
  "author": "lexdrev",
  "repository": {
    "type": "git",
    "url": "https://github.com/lexdrev/origami.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit && tsc --noEmit -p preview",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite --config preview/vite.config.js",
    "preview:build": "vite build --config preview/vite.config.js"
  },
  "dependencies": {
    "@decky/api": "^1.1.3"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.16.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@rollup/plugin-url": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rollup": "^4.65.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
